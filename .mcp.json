{
	"mcpServers": {
		"serena": {
			"type": "stdio",
			"command": "bash",
			"args": [
				"-c",
				"cd /home/mau/serena && /home/mau/.local/bin/uv run serena start-mcp-server --project /home/mau/Programas/calreact"
			],
			"env": {}
		},
		"firebase": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"-y",
				"firebase-tools@latest",
				"experimental:mcp"
			],
			"env": {}
		},
		"shadcn": {
      		"command": "npx",
      		"args": ["-y", "mcp-remote", "https://www.shadcn.io/api/mcp"]
        },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ],
      "env": {}
    }
    }
}
